# ==============================================================================
# BagGuard AI — Environment Configuration
# ==============================================================================

# Application Mode
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Standalone mode uses SQLite by default for zero-setup offline running.
# To connect to Supabase PostgreSQL, uncomment and provide the DATABASE_URL.
DATABASE_URL=sqlite:///./bagguard.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage & Realtime (Optional - Local storage fallback is used if omitted)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=bagguard-evidence

# Local Storage Directory (Used when Supabase is not configured)
STORAGE_LOCAL_DIR=./storage_data

# Computer Vision & Models
YOLO_MODEL_PATH=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
CONVEYOR_PIXEL_TO_METER_RATIO=0.005
POSE_ESTIMATION_ENABLED=True
TEMPORAL_SMOOTHING_WINDOW=5

# RFID Integration Mode (demo | physical_serial | api_relay)
RFID_MODE=demo
RFID_SERIAL_PORT=COM3
RFID_BAUD_RATE=9600

# Groq inspection reports (keep this key on the backend only; never prefix with VITE_)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_REPORTS_ENABLED=True
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Scoring & Risk Thresholds
INITIAL_SCORE_BASELINE=100
HIGH_RISK_THRESHOLD=65
CRITICAL_DEFECT_PENALTY=30
MAJOR_DEFECT_PENALTY=15
MINOR_DEFECT_PENALTY=5

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
