# ==============================================================================
# BagGuard AI — Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for local instant run, seamlessly swaps to Postgres)
DATABASE_URL=sqlite:///./bagguard.db

# Storage (Local fallback active)
STORAGE_LOCAL_DIR=./storage_data

# Computer Vision & Models
YOLO_MODEL_PATH=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
CONVEYOR_PIXEL_TO_METER_RATIO=0.005
POSE_ESTIMATION_ENABLED=True
TEMPORAL_SMOOTHING_WINDOW=5

# RFID Mode (demo | physical_serial)
RFID_MODE=demo

# Scoring Defaults
INITIAL_SCORE_BASELINE=100
HIGH_RISK_THRESHOLD=65
CRITICAL_DEFECT_PENALTY=30
MAJOR_DEFECT_PENALTY=15
MINOR_DEFECT_PENALTY=5

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
